# Feature flag do checkout: controla qual fluxo de finalizacao de acordo sera exibido.
# 'true' (ou ausente) = fluxo v2, com escolha de pagamento por Pix ou boleto.
# 'false' = fluxo v1, confirmacao direta sem escolha de metodo de pagamento.
# NEXT_PUBLIC_CHECKOUT_V2=false

# Simula erro na API de ofertas: quando definida com um status HTTP valido (ex.: 500, 503),
# NEXT_PUBLIC_MOCK_OFFERS_ERROR=500

# Simula erro na API de checkout: quando definida com um status HTTP valido (ex.: 500, 503),
# NEXT_PUBLIC_MOCK_CHECKOUT_ERROR=500
